# SQLite is ideal for local single-user development. Replace with a PostgreSQL
# URL before deploying or enabling background workers.
DATABASE_URL=sqlite:///./fieldnotes.db
ENVIRONMENT=development
QUOTE_CACHE_MINUTES=15
DEFAULT_BENCHMARK=SPY

# Deployment placeholders. Never commit real values.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_PROVIDER_CLIENT_ID=
AUTH_PROVIDER_CLIENT_SECRET=
APP_URL=http://localhost:8000
MARKET_DATA_PROVIDER=yfinance
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
